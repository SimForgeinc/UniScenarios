 "meta": {
  "name": "Signal blackout: the head goes dark and the cross traffic keeps coming",
  "description": "A working signal on the ego's approach loses power mid-clip. A dark head is not an uncontrolled junction: the law reverts the intersection to an all-way stop, so the ego must stop at a line it was about to cross on green. The vehicle on the crossing arm is not stopping, and the two arrive together. This is the degraded-infrastructure encounter that a fixed phase list cannot express, because a phase list has no failure in it.",
  "createdAt": "2026-08-07T00:00:00.000Z",
  "modifiedAt": "2026-08-07T00:00:00.000Z",
  "appVersion": "uniscenarios/0.0.1",
  "archetype": "C3.control-failure",
  "tags": ["signal-blackout", "control-failure", "all-way-stop", "junction-conflict", "degraded-infrastructure"],
  "author": "agent/caps-surface",
  "negativeControl": false
 },
 "params": {
  "declarations": [
   {"id": "egoSpeedKph", "type": "continuous", "description": "ego approach speed", "unit": "kph", "tier": 1, "range": [38, 52], "default": 45, "distribution": "uniform"},
   {"id": "crossSpeedKph", "type": "continuous", "description": "speed of the vehicle on the crossing arm", "unit": "kph", "tier": 1, "range": [30, 46], "default": 38, "distribution": "uniform"},
   {"id": "blackoutAtS", "type": "continuous", "description": "green duration before the head loses power; the program clock starts at -warmupSeconds, so the blackout lands at this minus the warm-up", "unit": "s", "tier": 1, "range": [0.8, 1.5], "default": 1.15, "distribution": "uniform"},
   {"id": "conflictDeltaT", "type": "continuous", "description": "seconds the crossing vehicle reaches the conflict point after the ego would have, had the signal not failed", "unit": "s", "tier": 1, "range": [0.0, 0.7], "default": 0.35, "distribution": "uniform"}
  ],
  "constraints": []
 },
