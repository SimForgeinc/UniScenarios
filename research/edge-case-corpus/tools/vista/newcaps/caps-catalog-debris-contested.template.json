  "choreography": {
    "clipSeconds": 10,
    "warmupSeconds": 1,
    "interactions": [
      {
        "id": "ego-slows-for-debris",
        "actor": "ego",
        "verb": "speed",
        "trigger": {
          "kind": "when",
