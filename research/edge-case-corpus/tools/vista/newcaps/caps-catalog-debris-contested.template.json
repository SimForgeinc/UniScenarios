{
  "scenarioVersion": 2,
  "meta": {
    "name": "Tyre carcass in the wheel path, ego steers around it",
    "description": "A shed retread lies in the ego wheel path (object.tyre). The ego stays on the lane centre \u2014 genuinely on a collision course, so the static hazard is a scored metric pair \u2014 and only displaces laterally on a late distance trigger, passing the hazard within a metre instead of halting 5 m short of it.",
    "createdAt": "2026-08-01T00:00:00.000Z",
    "modifiedAt": "2026-08-01T00:00:00.000Z",
    "appVersion": "uniscenarios/0.0.1",
    "archetype": "obstacle.fallen-cargo",
    "tags": [
      "obstacle",
      "debris",
      "tyre",
      "evasive-steer",
      "newcaps"
    ],
    "author": "agent/caps-catalog",
    "negativeControl": false
  },
  "params": {
    "declarations": [
      {
        "id": "cargoOffsetFrac",
        "type": "continuous",
        "description": "Hazard lateral centre inside the ego lane; negative keeps it in the near wheel path.",
        "unit": "lane-width",
        "tier": 1,
        "range": [
          -0.35,
          -0.12
        ],
        "default": -0.24,
        "distribution": "uniform"
      },
      {
        "id": "swerveFrac",
        "type": "continuous",
        "description": "How far the ego displaces laterally to clear the hazard.",
        "unit": "lane-width",
        "tier": 1,
        "range": [
          0.3,
          0.55
        ],
        "default": 0.42,
        "distribution": "uniform"
      },
      {
        "id": "approachFactor",
        "type": "continuous",
        "description": "Speed the ego carries through the avoidance, as a factor of its approach speed.",
        "unit": "1",
        "tier": 1,
        "range": [
          0.6,
          0.85
        ],
        "default": 0.72,
        "distribution": "uniform"
      }
    ],
    "constraints": []
  },
