        "dynamics": {
          "shape": "linear",
          "constraint": "time",
          "value": 1.6
        }
      },
      {
        "id": "ego-steers-around-debris",
        "actor": "ego",
        "verb": "laneOffset",
        "trigger": {
          "kind": "when",
          "condition": {
            "kind": "distance",
            "from": "ego",
            "to": {
              "role": "cargo"
            },
            "measure": "alongLane",
            "op": "<=",
            "valueM": 16
          },
          "byLatest": 8,
          "ifNever": "fire"
        },
        "target": {
          "tFrac": "param.swerveFrac",
          "reference": "lane_center"
        },
        "dynamics": {
          "shape": "linear",
          "constraint": "time",
          "value": 1.2
        }
      }
