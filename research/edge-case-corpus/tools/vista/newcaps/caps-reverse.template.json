{
  "scenarioVersion": 2,
  "meta": {
    "name": "Car reverses out of a driveway across the ego's lane",
    "description": "A vehicle parked nose-in beside the carriageway selects reverse on the timeline and backs rear-first out of its bay across the ego's travel lane, forcing the ego to brake. Reverse is authored with the typed `motion.gear` set key rather than an untyped role extension, so it is triggerable, conditional and bounded like any other manoeuvre.",
    "createdAt": "2026-08-07T00:00:00.000Z",
    "modifiedAt": "2026-08-07T00:00:00.000Z",
    "appVersion": "uniscenarios/0.0.1",
    "archetype": "parking.reverse-out-of-driveway",
    "tags": [
      "parking",
      "reversing",
      "motion.gear",
      "driveway",
      "backing"
    ],
    "author": "agent/caps-reverse",
    "negativeControl": false
  },
  "params": {
    "declarations": [
      {
        "id": "reverseSpeedKph",
        "type": "continuous",
        "unit": "kph",
        "tier": 1,
        "range": [
          4,
          9
        ],
        "default": 6,
        "distribution": "uniform"
      },
      {
        "id": "brakeTriggerDistanceM",
        "type": "continuous",
        "unit": "m",
        "tier": 1,
        "range": [
          18,
          28
        ],
        "default": 23,
        "distribution": "uniform"
      }
    ],
    "constraints": []
  },
  "environment": {
    "weather": "clear",
    "timeOfDay": "afternoon"
  },
  "anchor": {
    "id": "reverse-out-of-driveway",
    "corridor": {
      "throughLanesSameDir": {
        "value": [
          1,
          4
        ],
        "essentiality": "required"
      },
      "speedLimitKph": {
        "value": [
          15,
          50
        ],
        "essentiality": "preferred"
      },
      "curvatureDegPer10m": {
        "value": [
          0,
          8
        ],
        "essentiality": "required"
      },
      "runwayDownstreamM": {
        "value": [
          100,
          null
        ],
        "essentiality": "required"
      }
    },
    "features": [
      {
        "id": "driveway",
        "kind": "parking_zone",
        "label": "kerbside bay or driveway mouth beside the travel lane",
        "essentiality": "required",
        "atM": {
          "value": [
            30,
            100
          ],
          "essentiality": "required"
        },
        "side": {
          "value": "right",
          "essentiality": "preferred"
        }
      }
    ],
    "policy": {
      "allowMirror": true,
      "maxSitesPerMap": 12,
      "diversity": "moderate",
      "minScore": 0.45
    }
  },
  "roles": [
    {
      "id": "ego",
      "kind": "on_reference",
      "label": "vehicle approaching the driveway mouth",
      "actor": {
        "class": "car",
        "catalogId": "vehicle.sedan"
      },
      "pose": {
        "laneOffset": 0,
        "s": "-clamp(0.65 * lane.speedLimitKph, 18, 35) / 3.6 * 5",
        "tFrac": 0,
        "headingOffsetRad": 0
      },
      "initialSpeedKph": "clamp(0.65 * lane.speedLimitKph, 18, 35)",
      "extensions": {
        "placementFeature": "driveway"
      }
    },
    {
      "id": "backing-car",
      "kind": "in_parking_zone",
      "label": "car parked nose-in in the driveway, about to reverse out",
      "actor": {
        "class": "car",
        "catalogId": "vehicle.suv"
      },
      "feature": "driveway",
      "slot": "any",
      "facing": "perpendicular",
      "initialSpeedKph": 0,
      "extensions": {
        "placementFeature": "driveway"
      }
    }
  ],
  "props": [],
  "choreography": {
    "clipSeconds": 12,
    "warmupSeconds": 2,
    "interactions": [
      {
        "id": "backing-path",
        "actor": "backing-car",
        "verb": "route",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "mode": "polyline",
          "points": [
            {
              "laneOffset": 0,
              "s": 0,
              "tFrac": -1.0,
              "headingOffsetRad": 1.5707963267948966
            },
            {
              "laneOffset": 0,
              "s": -1.5,
              "tFrac": -0.4,
              "headingOffsetRad": 1.5707963267948966
            },
            {
              "laneOffset": 0,
              "s": -3.0,
              "tFrac": 0.2,
              "headingOffsetRad": 1.5707963267948966
            }
          ]
        }
      },
      {
        "id": "select-reverse",
        "actor": "backing-car",
        "verb": "set",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "key": "motion.gear",
          "value": "reverse"
        }
      },
      {
        "id": "reverse-lamps-on",
        "actor": "backing-car",
        "verb": "set",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "key": "lights.reverse",
          "value": true
        }
      },
      {
        "id": "backing-commits",
        "actor": "backing-car",
        "verb": "set",
        "trigger": {
          "kind": "at",
          "t": 0.4
        },
        "target": {
          "key": "rules.collisionAvoidance",
          "value": false
        }
      },
      {
        "id": "backs-out",
        "actor": "backing-car",
        "verb": "speed",
        "trigger": {
          "kind": "at",
          "t": 0.6
        },
        "target": {
          "mode": "absolute",
          "valueKph": "param.reverseSpeedKph"
        },
        "dynamics": {
          "shape": "linear",
          "constraint": "time",
          "value": 1.2
        }
      },
      {
        "id": "ego-brakes",
        "actor": "ego",
        "verb": "speed",
        "trigger": {
          "kind": "when",
          "condition": {
            "kind": "distance",
            "from": "ego",
            "to": {
              "role": "backing-car"
            },
            "measure": "euclidean",
            "op": "<=",
            "valueM": "param.brakeTriggerDistanceM"
          },
          "byLatest": 8,
          "ifNever": "fire"
        },
        "target": {
          "mode": "stop"
        },
        "dynamics": {
          "shape": "linear",
          "constraint": "rate",
          "value": 4
        }
      }
    ]
  },
  "invariants": [
    {
      "id": "reverse-before-motion",
      "kind": "event_order",
      "events": [
        "select-reverse",
        "backs-out"
      ],
      "strict": true,
      "essentiality": "required"
    },
    {
      "id": "ego-decel-budget",
      "kind": "decel_budget",
      "of": "ego",
      "maxMps2": 8,
      "essentiality": "required"
    }
  ],
  "variants": [],
  "metricSubject": "ego"
}
