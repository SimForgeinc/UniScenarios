    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:map": "tsx src/cli/build-map.ts"
  },
  "dependencies": {
    "@uniscenarios/xodr-tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
