{
  "name": "@uniscenarios/map-intel",
  "version": "0.1.0-rc.12",
  "repository": { "type": "git", "url": "git+https://github.com/SimForgeinc/UniScenarios.git", "directory": "packages/map-intel" },
  "publishConfig": { "access": "public", "provenance": true },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": [
    "dist"
  ],
  "scripts": {
