{
  "name": "@uniscenarios/openscenario",
  "version": "0.1.0-rc.35",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/UniScenarios.git",
    "directory": "packages/openscenario"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./import": {
      "types": "./dist/import.d.ts",
      "default": "./dist/import.js"
    },
    "./conformance/*": "./conformance/*",
    "./schema/*": "./schema/*",
    "./execution-plan": {
      "types": "./dist/execution-plan.d.ts",
      "default": "./dist/execution-plan.js"
    }
  },
  "files": [
    "dist",
    "conformance",
    "schema"
  ],
  "dependencies": {
    "fast-xml-parser": "^5.5.6",
    "@uniscenarios/cli": "workspace:*",
    "@uniscenarios/scenario-model": "workspace:*",
    "@uniscenarios/sim-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/import.ts src/execution-plan.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
