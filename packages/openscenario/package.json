{
  "name": "@uniscenarios/openscenario",
  "version": "0.1.0-rc.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/UniScenarios.git",
    "directory": "packages/openscenario"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./import": { "types": "./dist/import.d.ts", "default": "./dist/import.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/import.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@uniscenarios/cli": "workspace:*",
    "@uniscenarios/scenario-model": "workspace:*",
    "fast-xml-parser": "^5.5.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
