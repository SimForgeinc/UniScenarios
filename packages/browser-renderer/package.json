{
  "name": "@uniscenarios/browser-renderer",
  "version": "0.1.0-rc.42",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "default": "./dist/headless.js"
    }
  },
  "files": ["dist", "harness.html"],
  "dependencies": {
    "@uniscenarios/city-renderer": "workspace:*",
    "@uniscenarios/playback": "workspace:*",
    "@uniscenarios/render-runtime": "workspace:*",
    "@uniscenarios/scenario-model": "workspace:*",
    "playwright-core": "^1.62.1",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.185.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --out-dir dist && tsup src/headless.ts --format esm --dts --sourcemap --out-dir dist --no-external @uniscenarios/city-renderer --no-external @uniscenarios/playback --no-external @uniscenarios/scenario-model --no-external three",
    "typecheck": "tsc --noEmit"
  }
}
