{
  "name": "@scenario-studio/scenario-model",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema.json": "./schema/scenario.v1.schema.json",
    "./schema/template.v2.json": "./schema/scenario-template.v2.schema.json",
    "./schema/anchor.v2.json": "./schema/logical-anchor.v2.schema.json",
    "./schema/interactions.v2.json": "./schema/interactions.v2.schema.json"
  },
  "files": [
    "src",
    "schema"
  ],
  "scripts": {
    "build": "pnpm run schema && tsc --noEmit",
    "schema": "tsx scripts/generate-json-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "immer": "^11.1.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
