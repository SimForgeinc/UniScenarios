        "tier": 1,
        "range": [
          0.8,
          2.5
        ],
        "default": 1.6,
        "distribution": "uniform"
      },
      {
        "id": "pedSpeedKph",
        "type": "continuous",
        "description": "Pedestrian travel speed. An alighting passenger in a hurry runs; Euro NCAP walk = 5 km/h, run = 8 km/h.",
        "unit": "kph",
        "tier": 1,
        "range": [
          4.0,
          8.5
        ],
        "default": 5.4,
        "distribution": "uniform"
      },
      {
        "id": "busGapM",
        "type": "continuous",
        "description": "Metres between the bus centre and the line the pedestrian crosses on. The bus is 12.2 m long, so 7 m puts the pedestrian right across its bumper and 14 m gives a clear car-length of daylight first.",
