        "description": "Metres upstream of the conflict point at which the pedestrian leaves the kerb line. With `pedSpeedKph` this is the reveal-to-conflict lever.",
        "unit": "m",
        "tier": 1,
        "range": [
          1.5,
          4.5
        ],
        "default": 2.8,
        "distribution": "uniform"
      }
    ],
    "constraints": []
  },
