{
  "scenarioVersion": 2,
  "meta": {
    "name": "Ambulance Through a Gridlocked Intersection",
    "description": "At a red signal, ego remains stopped while live cross traffic clears and a pedestrian completes the near crossing. Only after both conflicts clear, ego creeps forward-right at walking speed to create a refuge corridor, stops without following through the red, and an ambulance arriving from behind passes without stopping.",
    "createdAt": "2026-08-02T07:00:00.000Z",
    "modifiedAt": "2026-08-02T07:00:00.000Z",
    "appVersion": "uniscenarios/0.1.0-editor",
    "archetype": "edge.emergency-yield-minimal-red-encroachment",
    "tags": ["edge-case", "ambulance", "emergency-vehicle", "gridlock", "signalized", "pedestrian", "minimal-encroachment"],
    "author": "codex/edge_campaign_05_06",
    "negativeControl": false
  },
  "params": { "declarations": [], "constraints": [] },
  "environment": { "weather": "clear", "timeOfDay": "noon" },
  "anchor": {
    "id": "ambulance-gridlocked-signalized-intersection",
    "corridor": {
      "throughLanesSameDir": { "value": [2, 5], "essentiality": "required" },
      "runwayUpstreamM": { "value": [150, null], "essentiality": "required" },
      "runwayDownstreamM": { "value": [75, null], "essentiality": "required" }
    },
    "features": [
      {
        "id": "gridlock-junction", "kind": "junction", "essentiality": "required",
        "atM": { "value": [0, 0], "essentiality": "required" },
        "arms": { "value": [4, 4], "essentiality": "required" },
        "control": { "value": ["signalized"], "essentiality": "required" },
        "egoTurn": { "value": ["straight"], "essentiality": "required" },
        "conflictingApproach": { "value": { "from": "from_left", "turn": "straight", "crossingAngleDeg": [60, 120] }, "essentiality": "required" }
      },
      {
        "id": "near-crosswalk", "kind": "crossing", "label": "near-side marked pedestrian crossing",
        "essentiality": "required", "atM": { "value": [-8, 8], "essentiality": "preferred" },
        "marked": { "value": true, "essentiality": "preferred" }, "placement": { "value": "either", "essentiality": "preferred" }
      }
    ],
    "policy": { "allowMirror": true, "maxSitesPerMap": 12, "diversity": "strict", "minScore": 0.45 }
  },
  "roles": [
    {
      "id": "ego", "kind": "on_reference", "label": "first vehicle stopped at red",
      "actor": { "class": "car", "catalogId": "vehicle.sedan" },
      "pose": { "laneOffset": 0, "s": -13, "tFrac": 0, "headingOffsetRad": 0 }, "initialSpeedKph": 0
    },
    {
      "id": "ambulance", "kind": "relative_to", "ref": "ego", "dLane": 0, "dsM": -118, "tFrac": 0, "headingOffsetRad": 0,
      "label": "ambulance approaching from behind with audible siren",
      "actor": { "class": "car", "catalogId": "vehicle.ambulance", "dims": { "length": 6.1, "width": 2.1, "height": 2.65 } },
      "initialSpeedKph": 24,
      "extensions": { "emergencyVehicle": "ambulance" }
    },
    {
      "id": "cross-traffic", "kind": "conflicting_gate", "feature": "gridlock-junction", "from": "from_left", "turn": "straight",
      "label": "initially live cross traffic that clears before ego yields",
      "actor": { "class": "car", "catalogId": "vehicle.suv" },
      "fallbackPose": { "laneOffset": 0, "s": -22, "tFrac": 0, "headingOffsetRad": 0 }, "requiredUpstreamRunwayM": 25,
      "initialSpeedKph": 34
    },
    {
      "id": "pedestrian", "kind": "on_crossing", "feature": "near-crosswalk", "startFrac": 0.04, "direction": "near_to_far", "lateralFrac": 0,
      "label": "pedestrian who must clear before ego repositions",
      "actor": { "class": "pedestrian", "catalogId": "pedestrian.adult_walking" }, "initialSpeedKph": 0
    },
    {
      "id": "downstream-queue", "kind": "lane_offset", "k": 1, "onMissing": "fail",
      "label": "stopped downstream queue constraining the available refuge",
      "actor": { "class": "truck", "catalogId": "vehicle.box_truck", "static": true },
      "pose": { "laneOffset": 1, "s": 18, "tFrac": 0, "headingOffsetRad": 0 }, "initialSpeedKph": 0
    }
  ],
  "props": [],
  "choreography": {
    "clipSeconds": 20, "warmupSeconds": 1,
    "interactions": [
      { "id": "ego-red", "actor": "@world", "verb": "set", "trigger": { "kind": "at", "t": 0 }, "target": { "key": "signal:feature:gridlock-junction:ego.phase", "value": "red" }, "label": "Ego approach remains red for the full clip" },
      { "id": "cross-green", "actor": "@world", "verb": "set", "trigger": { "kind": "at", "t": 0 }, "target": { "key": "signal:feature:gridlock-junction:left.phase", "value": "green" }, "label": "Cross traffic begins with right of way" },
      { "id": "ego-holds", "actor": "ego", "verb": "speed", "trigger": { "kind": "at", "t": 0 }, "target": { "mode": "stop" }, "dynamics": { "shape": "step", "constraint": "time", "value": 0.1 } },
      { "id": "ambulance-siren", "actor": "ambulance", "verb": "set", "trigger": { "kind": "at", "t": 0.2 }, "target": { "key": "lights.emergency", "value": "flashing_siren" }, "label": "Siren is audible before the ambulance reaches the junction scene" },
      { "id": "ambulance-horn-1-on", "actor": "ambulance", "verb": "set", "trigger": { "kind": "at", "t": 2 }, "target": { "key": "audio.horn", "value": true }, "label": "First 350 ms emergency horn burst begins" },
      { "id": "ambulance-horn-1-off", "actor": "ambulance", "verb": "set", "trigger": { "kind": "at", "t": 2.35 }, "target": { "key": "audio.horn", "value": false }, "label": "First emergency horn burst ends" },
      { "id": "ambulance-horn-2-on", "actor": "ambulance", "verb": "set", "trigger": { "kind": "at", "t": 2.55 }, "target": { "key": "audio.horn", "value": true }, "label": "Second 350 ms emergency horn burst begins" },
      { "id": "ambulance-horn-2-off", "actor": "ambulance", "verb": "set", "trigger": { "kind": "at", "t": 2.9 }, "target": { "key": "audio.horn", "value": false }, "label": "Second emergency horn burst ends" },
      { "id": "ambulance-exempt", "actor": "ambulance", "verb": "set", "trigger": { "kind": "after", "of": "ambulance-siren", "event": "start", "delayS": 0 }, "target": { "key": "rules.obeySignals", "value": false } },
      { "id": "pedestrian-enters", "actor": "pedestrian", "verb": "speed", "trigger": { "kind": "at", "t": 4 }, "target": { "mode": "absolute", "valueKph": 5 }, "dynamics": { "shape": "linear", "constraint": "time", "value": 0.4 }, "label": "Pedestrian enters while ego remains stopped" },
      { "id": "cross-traffic-clears", "actor": "cross-traffic", "verb": "speed", "trigger": { "kind": "at", "t": 7.5 }, "target": { "mode": "stop" }, "dynamics": { "shape": "linear", "constraint": "time", "value": 2 }, "label": "Nearest cross stream has cleared and closes" },
      { "id": "cross-red", "actor": "@world", "verb": "set", "trigger": { "kind": "after", "of": "cross-traffic-clears", "event": "end", "delayS": 0 }, "target": { "key": "signal:feature:gridlock-junction:left.phase", "value": "red" } },
      { "id": "pedestrian-clears", "actor": "pedestrian", "verb": "speed", "trigger": { "kind": "at", "t": 12.2 }, "target": { "mode": "stop" }, "dynamics": { "shape": "linear", "constraint": "time", "value": 0.5 }, "label": "Pedestrian reaches the far side" },
      { "id": "ego-nudges-right", "actor": "ego", "verb": "laneOffset", "trigger": { "kind": "after", "of": "pedestrian-clears", "event": "end", "delayS": 0.4 }, "target": { "tFrac": -0.82, "reference": "lane_center" }, "dynamics": { "shape": "sinusoidal", "constraint": "time", "value": 1.8 }, "label": "Ego moves right only after both protected conflicts clear" },
      { "id": "ego-creeps", "actor": "ego", "verb": "speed", "trigger": { "kind": "after", "of": "pedestrian-clears", "event": "end", "delayS": 0.4 }, "until": { "kind": "after", "of": "ego-creeps", "event": "start", "delayS": 2 }, "target": { "mode": "absolute", "valueKph": 6 }, "dynamics": { "shape": "linear", "constraint": "time", "value": 0.6 }, "label": "Minimal forward encroachment at no more than 8 km/h" },
      { "id": "ego-stops-pocket", "actor": "ego", "verb": "speed", "trigger": { "kind": "after", "of": "ego-creeps", "event": "start", "delayS": 2 }, "target": { "mode": "stop" }, "dynamics": { "shape": "linear", "constraint": "time", "value": 0.4 }, "label": "Ego stops and does not follow through red" },
      { "id": "ambulance-passes", "actor": "ambulance", "verb": "speed", "trigger": { "kind": "after", "of": "ego-stops-pocket", "event": "end", "delayS": 0.2 }, "target": { "mode": "absolute", "valueKph": 38 }, "dynamics": { "shape": "linear", "constraint": "time", "value": 0.8 }, "label": "Ambulance passes through the created corridor without stopping" },
      { "id": "ambulance-commits", "actor": "ambulance", "verb": "set", "trigger": { "kind": "after", "of": "ambulance-passes", "event": "start", "delayS": 0 }, "target": { "key": "rules.collisionAvoidance", "value": false } }
    ]
  },
  "invariants": [
    { "id": "protected-yield-order", "kind": "event_order", "events": ["ambulance-siren", "ambulance-horn-1-on", "ambulance-horn-1-off", "ambulance-horn-2-on", "ambulance-horn-2-off", "pedestrian-enters", "cross-traffic-clears", "pedestrian-clears", "ego-creeps", "ego-stops-pocket", "ambulance-passes"], "strict": true, "minSeparationS": 0.1, "essentiality": "required" },
    { "id": "ego-deceleration", "kind": "decel_budget", "of": "ego", "maxMps2": 8, "essentiality": "required" },
    { "id": "pedestrian-clearance", "kind": "pet", "of": "ego", "to": "pedestrian", "range": [0.2, null], "window": [10, 18], "essentiality": "required" }
  ],
  "variants": [], "metricSubject": "ego",
  "extensions": {
    "x-uniscenarios.stableId": "edge-05-ambulance-gridlock-v1",
    "x-uniscenarios.acceptance": {
      "egoStationaryUntilS": 12.7, "egoMaxRelocationKph": 8, "egoMustRemainBeforeFarCrosswalk": true,
      "minimumCorridorWidthM": 3, "ambulanceMustNotStop": true,
      "mustNot": ["enter live cross traffic", "mount occupied sidewalk", "follow ambulance through red", "remain immobile after safe pocket exists"]
    },
    "x-uniscenarios.specialActorSupport": "vehicle.ambulance is a first-class movable catalog actor; flashing_siren and two explicit 350 ms audio.horn bursts are first-class timeline state."
  }
}
