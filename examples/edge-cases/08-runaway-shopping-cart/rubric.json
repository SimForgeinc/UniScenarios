{
  "intentId": "edge-case-08-runaway-cart-rain-glare",
  "title": "Runaway Shopping Cart in Rain and Glare",
  "requiredEventOrder": ["cart-rolls", "ego-progressive-brake", "cart-hits-median", "pedestrian-steps", "pedestrian-notices-cart", "cart-rolls-back", "cart-secured"],
  "acceptance": [
    { "id": "environment-rain", "measure": "operationalConditions.weather", "op": "=", "value": "heavy_rain" },
    { "id": "environment-friction", "measure": "operationalConditions.frictionScale", "op": "<=", "value": 0.58 },
    { "id": "directional-glare", "measure": "operationalConditions.visibility", "op": "=", "value": "directional-glare" },
    { "id": "approach-speed", "measure": "speed(ego,drivewayConflict)", "op": "<=", "value": 20, "unit": "kph" },
    { "id": "cart-stop-distance", "measure": "distance(ego,cart,egoStop)", "op": ">=", "value": 3, "unit": "m" },
    { "id": "no-lateral-escape", "measure": "egoLaneChanges", "op": "=", "value": 0 },
    { "id": "rollback-hold", "measure": "maxSpeed(ego,15..18s)", "op": "<=", "value": 0.2, "unit": "m/s" },
    { "id": "pedestrian-clearance", "measure": "minDistance(ego,umbrella-pedestrian)", "op": ">=", "value": 1.5, "unit": "m" },
    { "id": "cart-rollback", "measure": "cartLateralDirectionChanges", "op": ">=", "value": 1 }
  ],
  "forbidden": ["ego drives through cart", "ego enters oncoming lane", "ego resumes after first clearance", "shopper enters roadway"],
  "siteGate": {
    "exactRequired": ["divided commercial boulevard", "sloped side access", "access immediately before marked midblock crossing", "median curb", "oncoming approach"],
    "allowBehavioralSurrogate": true,
    "surrogateMustBeLabeled": true
  }
}
