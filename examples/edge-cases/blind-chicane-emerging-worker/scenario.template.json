{
  "scenarioVersion": 2,
  "meta": {
    "name": "Blind Chicane and Emerging Worker",
    "description": "Ego enters an alternating-flow construction chicane while an oncoming van is still clearing it. A worker carrying a long pipe emerges from behind an excavator after ego is committed. Ego slows below the work-zone cap, keeps right, stops clear of the worker without obstructing the van, and resumes only after both hazards clear.",
    "createdAt": "2026-08-02T07:00:00.000Z",
    "modifiedAt": "2026-08-02T07:00:00.000Z",
    "appVersion": "uniscenarios/0.1.0-editor",
    "archetype": "edge.workzone.blind-chicane-emerging-worker",
    "tags": ["edge-case", "work-zone", "chicane", "alternating-flow", "occluded-worker", "excavator", "portable-signal"],
    "author": "codex/edge_campaign_01_02",
    "negativeControl": false
  },
  "params": {
    "declarations": [
      { "id": "chicaneSpeedKph", "type": "continuous", "unit": "kph", "tier": 1, "range": [12, 15], "default": 14, "distribution": "uniform" },
      { "id": "workerSpeedKph", "type": "continuous", "unit": "kph", "tier": 1, "range": [4.5, 6], "default": 5.2, "distribution": "uniform" }
    ],
    "constraints": []
  },
  "environment": { "weather": "clear", "timeOfDay": "afternoon", "extensions": { "workZone": "active", "portableAlternatingControl": true } },
  "anchor": {
