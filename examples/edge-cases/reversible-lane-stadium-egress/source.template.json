      { "id": "transitionSpeedKph", "type": "continuous", "unit": "kph", "tier": 1, "range": [5, 10], "default": 8, "distribution": "uniform" },
      { "id": "mergeRateMps", "type": "continuous", "unit": "m/s", "tier": 1, "range": [1.2, 1.5], "default": 1.4, "distribution": "uniform" }
    ],
    "constraints": []
  },
  "environment": { "weather": "clear", "timeOfDay": "night_lit" },
  "anchor": {
