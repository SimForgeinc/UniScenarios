      "speedLimitKph": { "value": [25, 60], "essentiality": "preferred" },
      "curvatureDegPer10m": { "value": [0, 5], "essentiality": "required" },
      "runwayDownstreamM": { "value": [190, null], "essentiality": "required" },
      "laneChangeLegal": { "value": { "side": "right", "sRange": [45, 130] }, "essentiality": "preferred" }
    },
    "features": [],
    "policy": { "allowMirror": true, "maxSitesPerMap": 16, "diversity": "moderate", "minScore": 0.45 }
  },
  "trafficControls": [
    {
      "id": "downstream-lane-control",
      "kind": "lane_control",
      "label": "nearest applicable downstream reversible-lane display",
      "pose": { "s": 90, "laneOffset": 0, "tFrac": 0 },
      "stopLines": [{ "pose": { "s": 100, "laneOffset": 0, "tFrac": 0 } }],
      "phases": [{ "indication": "green_arrow", "durationS": 5 }, { "indication": "red_x", "durationS": 16 }],
      "offsetS": 0,
      "loop": false
    }
  ],
  "roles": [
    { "id": "ego", "kind": "on_reference", "label": "vehicle committed to the reversible center lane", "actor": { "class": "car", "catalogId": "vehicle.sedan" }, "pose": { "laneOffset": 0, "s": 30, "tFrac": 0, "headingOffsetRad": 0 }, "initialSpeedKph": 28 },
    { "id": "rideshare", "kind": "relative_to", "ref": "ego", "dLane": 0, "dsM": 180, "tFrac": 0.1, "headingOffsetRad": 3.141592, "label": "oncoming rideshare committed under the previous lane configuration", "actor": { "class": "car", "catalogId": "vehicle.suv" }, "initialSpeedKph": 5, "requiredSameSegmentAs": "ego", "extensions": { "reversibleDirection": "previous_configuration", "mustRemainInSharedCenterLane": true } },
    { "id": "shuttle", "kind": "lane_offset", "k": -1, "onMissing": "fail", "label": "shuttle that temporarily occludes the rideshare", "actor": { "class": "bus", "catalogId": "vehicle.bus" }, "pose": { "laneOffset": -1, "s": 95, "tFrac": 0.8, "headingOffsetRad": 0 }, "initialSpeedKph": 16, "extensions": { "occludes": { "observer": "ego", "target": "rideshare" } } },
    { "id": "following-car", "kind": "relative_to", "ref": "ego", "dLane": 0, "dsM": -28, "tFrac": 0, "headingOffsetRad": 0, "label": "impatient follower", "actor": { "class": "car", "catalogId": "vehicle.hatchback" }, "initialSpeedKph": 10 },
    { "id": "marshal", "kind": "lane_offset", "k": -1, "onMissing": "fail", "label": "traffic marshal repositioning the lane closure", "actor": { "class": "pedestrian", "catalogId": "pedestrian.traffic_marshal", "static": true }, "pose": { "laneOffset": -1, "s": 100, "tFrac": -0.95, "headingOffsetRad": 0 }, "initialSpeedKph": 0, "extensions": { "authorizedTrafficDirector": true } },
    { "id": "crowd", "kind": "lane_offset", "k": -1, "onMissing": "fail", "label": "pedestrian crowd held behind fencing", "actor": { "class": "pedestrian", "static": true }, "pose": { "laneOffset": -1, "s": 125, "tFrac": -0.98, "headingOffsetRad": 0 }, "initialSpeedKph": 0, "extensions": { "behindFence": true, "mustRemainOutsideRoadway": true } }
  ],
  "props": [
    { "id": "cone-taper", "catalogId": "construction.traffic_cone", "label": "moving closure line with one controlled merge gap", "essentiality": "required", "pose": { "laneOffset": 0, "s": 72, "tFrac": -0.75, "headingOffsetRad": 0 }, "headingOffsetRad": 0, "scale": 1, "repeat": { "count": 9, "spacingM": 7, "tFracStep": 0.12 } },
    { "id": "crowd-fence", "catalogId": "occluder.fence_run", "label": "fence separating the crowd from the transition", "essentiality": "preferred", "pose": { "laneOffset": -1, "s": 95, "tFrac": -0.98, "headingOffsetRad": 0 }, "headingOffsetRad": 0, "scale": 1, "repeat": { "count": 7, "spacingM": 4, "tFracStep": 0 } }
  ],
  "choreography": {
    "clipSeconds": 20,
    "warmupSeconds": 1,
    "interactions": [
      { "id": "ego-enters-under-green", "actor": "ego", "verb": "speed", "trigger": { "kind": "at", "t": 0 }, "target": { "mode": "absolute", "valueKph": 28 }, "dynamics": { "shape": "step", "constraint": "time", "value": 0.1 } },
      { "id": "rideshare-old-direction-route", "actor": "rideshare", "verb": "route", "trigger": { "kind": "at", "t": 0 }, "target": { "mode": "polyline", "points": [{ "laneOffset": 0, "s": 210, "tFrac": 0.1, "headingOffsetRad": 3.141592 }, { "laneOffset": 0, "s": 40, "tFrac": 0.1, "headingOffsetRad": 3.141592 }] } },
      { "id": "downstream-red-x", "actor": "@world", "verb": "set", "trigger": { "kind": "at", "t": 4 }, "target": { "key": "control:downstream-lane-control.indication", "value": "red_x" } },
      { "id": "marshal-closes-lane", "actor": "marshal", "verb": "set", "trigger": { "kind": "at", "t": 7 }, "target": { "key": "pose.gesture", "value": "halt" } },
      { "id": "ego-responds-to-red-x", "actor": "ego", "verb": "speed", "trigger": { "kind": "after", "of": "downstream-red-x", "event": "start", "delayS": 1.5 }, "target": { "mode": "absolute", "valueKph": "param.transitionSpeedKph" }, "dynamics": { "shape": "linear", "constraint": "time", "value": 1.5 } },
      { "id": "follower-brakes-for-transition", "actor": "following-car", "verb": "speed", "trigger": { "kind": "at", "t": 4 }, "target": { "mode": "absolute", "valueKph": 10 }, "dynamics": { "shape": "linear", "constraint": "time", "value": 3.5 } },
      { "id": "rideshare-brakes", "actor": "rideshare", "verb": "speed", "trigger": { "kind": "at", "t": 8.5 }, "target": { "mode": "stop" }, "dynamics": { "shape": "linear", "constraint": "time", "value": 2.2 } },
      { "id": "ego-merges-right", "actor": "ego", "verb": "changeLane", "trigger": { "kind": "at", "t": 13 }, "target": { "mode": "toRole", "role": "shuttle" }, "dynamics": { "shape": "sinusoidal", "constraint": "rate", "value": "param.mergeRateMps" } },
      { "id": "follower-attempts-pass", "actor": "following-car", "verb": "laneOffset", "trigger": { "kind": "at", "t": 16 }, "target": { "tFrac": 0.75, "reference": "lane_center" }, "dynamics": { "shape": "sinusoidal", "constraint": "rate", "value": 0.8 } },
      { "id": "follower-aborts-pass", "actor": "following-car", "verb": "laneOffset", "trigger": { "kind": "at", "t": 18 }, "target": { "tFrac": 0, "reference": "lane_center" }, "dynamics": { "shape": "sinusoidal", "constraint": "rate", "value": 0.9 } },
      { "id": "ego-proceeds-outbound", "actor": "ego", "verb": "speed", "trigger": { "kind": "at", "t": 18 }, "target": { "mode": "absolute", "valueKph": 8 }, "dynamics": { "shape": "linear", "constraint": "time", "value": 1.5 } }
    ]
  },
  "invariants": [
    { "id": "transition-chronology", "kind": "event_order", "events": ["ego-enters-under-green", "downstream-red-x", "ego-responds-to-red-x", "marshal-closes-lane", "rideshare-brakes", "ego-merges-right", "follower-attempts-pass", "ego-proceeds-outbound"], "strict": true, "minSeparationS": 0.5, "essentiality": "required" },
    { "id": "oncoming-separation", "kind": "gap", "of": "ego", "to": "rideshare", "unit": "distance", "range": [5, 120], "window": [8, 17], "essentiality": "required" },
    { "id": "rear-gap", "kind": "headway", "of": "following-car", "to": "ego", "range": [0.5, 6], "window": [12, 18], "essentiality": "preferred" },
    { "id": "ego-decel-budget", "kind": "decel_budget", "of": "ego", "maxMps2": 5, "essentiality": "required" }
  ],
