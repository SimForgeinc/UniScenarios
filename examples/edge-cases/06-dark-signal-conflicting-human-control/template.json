{
  "scenarioVersion": 2,
  "meta": {
    "name": "Dark Signal with Conflicting Human Control",
    "description": "With every signal head dark, ego makes a full stop. An authorized officer first waves cross traffic through. A turning bus then blocks the officer while the officer makes an ambiguous point toward ego and a cross-street SUV false-starts. Ego holds. Once the bus clears, the officer stops the SUV with a clear palm, beckons ego for more than one second, and ego crosses slowly while pedestrians remain held.",
    "createdAt": "2026-08-02T07:00:00.000Z", "modifiedAt": "2026-08-02T07:00:00.000Z",
    "appVersion": "uniscenarios/0.1.0-editor", "archetype": "edge.dark-signal-ambiguous-human-control",
    "tags": ["edge-case", "dark-signal", "police-control", "occluded-gesture", "false-start", "pedestrian"],
    "author": "codex/edge_campaign_05_06", "negativeControl": false
  },
  "params": { "declarations": [], "constraints": [] },
  "environment": { "weather": "overcast", "timeOfDay": "dusk" },
  "anchor": {
    "id": "dark-signal-human-control-junction",
    "corridor": {
      "throughLanesSameDir": { "value": [1, 4], "essentiality": "required" },
      "runwayUpstreamM": { "value": [50, null], "essentiality": "required" },
      "runwayDownstreamM": { "value": [75, null], "essentiality": "required" }
    },
    "features": [
      {
        "id": "dark-junction", "kind": "junction", "essentiality": "required",
        "atM": { "value": [0, 0], "essentiality": "required" }, "arms": { "value": [4, 4], "essentiality": "required" },
        "control": { "value": ["signalized"], "essentiality": "required" }, "egoTurn": { "value": ["straight"], "essentiality": "required" },
        "conflictingApproach": { "value": { "from": "from_left", "turn": "straight", "crossingAngleDeg": [65, 115] }, "essentiality": "required" }
      },
      {
        "id": "controlled-crosswalk", "kind": "crossing", "essentiality": "required",
        "atM": { "value": [-8, 8], "essentiality": "preferred" }, "marked": { "value": true, "essentiality": "preferred" },
        "placement": { "value": "either", "essentiality": "preferred" }
      }
    ],
    "policy": { "allowMirror": true, "maxSitesPerMap": 12, "diversity": "strict", "minScore": 0.45 }
  },
  "trafficControls": [
    {
      "id": "failed-ego-signal", "kind": "normal_signal", "label": "inoperative normal signal on ego approach",
      "feature": "dark-junction", "pose": { "laneOffset": 0, "s": -8, "tFrac": 0.9, "headingOffsetRad": 0 },
      "stopLines": [{ "pose": { "laneOffset": 0, "s": -10, "tFrac": 0, "headingOffsetRad": 0 }, "feature": "dark-junction" }],
      "phases": [{ "indication": "off", "durationS": 20 }], "offsetS": 0, "loop": false
    },
    {
      "id": "officer-ego-control", "kind": "human_director", "label": "authorized officer control of ego approach",
      "feature": "dark-junction", "pose": { "laneOffset": 0, "s": -5, "tFrac": 0.88, "headingOffsetRad": -3.14 },
      "stopLines": [{ "pose": { "laneOffset": 0, "s": -10, "tFrac": 0, "headingOffsetRad": 0 }, "feature": "dark-junction" }],
      "phases": [{ "indication": "stop", "durationS": 20 }], "offsetS": 0, "loop": false
    }
  ],
  "roles": [
    {
      "id": "ego", "kind": "on_reference", "label": "ego stopped at the failed signal",
      "actor": { "class": "car", "catalogId": "vehicle.sedan" },
      "pose": { "laneOffset": 0, "s": -30, "tFrac": 0, "headingOffsetRad": 0 }, "initialSpeedKph": 0
    },
    {
      "id": "officer", "kind": "on_reference", "label": "authorized police traffic director",
      "actor": { "class": "pedestrian", "catalogId": "construction.flagger", "static": true },
      "pose": { "laneOffset": 0, "s": -5, "tFrac": 0.88, "headingOffsetRad": -3.14 }, "initialSpeedKph": 0,
      "extensions": { "authorizedTrafficDirector": true, "uniform": "police" }
    },
    {
      "id": "cross-suv", "kind": "conflicting_gate", "feature": "dark-junction", "from": "from_left", "turn": "straight",
      "label": "cross-street SUV that mistakes the ambiguous gesture as priority",
      "actor": { "class": "car", "catalogId": "vehicle.suv" },
      "fallbackPose": { "laneOffset": 0, "s": -16, "tFrac": 0, "headingOffsetRad": 0 }, "requiredUpstreamRunwayM": 25, "initialSpeedKph": 0
    },
    {
      "id": "turning-bus", "kind": "conflicting_gate", "feature": "dark-junction", "from": "from_right", "turn": "left",
      "label": "turning bus that transiently occludes the officer",
      "actor": { "class": "bus", "catalogId": "vehicle.bus" },
      "fallbackPose": { "laneOffset": 0, "s": -22, "tFrac": 0, "headingOffsetRad": 0 }, "requiredUpstreamRunwayM": 30, "initialSpeedKph": 0
    },
    {
      "id": "pedestrian-group", "kind": "on_crossing", "feature": "controlled-crosswalk", "startFrac": 0.08, "direction": "near_to_far", "lateralFrac": 0,
      "label": "pedestrian group held throughout ego's movement",
      "actor": { "class": "pedestrian", "catalogId": "pedestrian.adult_standing", "dims": { "length": 0.8, "width": 1.4, "height": 1.75 } },
      "initialSpeedKph": 0
    }
  ],
  "props": [
    {
      "id": "temporary-control-line", "catalogId": "construction.temporary_stop_sign",
      "label": "three temporary stop-sign stations; one station is turned away and intentionally non-authoritative",
      "pose": { "laneOffset": 0, "s": -10, "tFrac": 0.9, "headingOffsetRad": 0 },
      "repeat": { "count": 3, "spacingM": 3, "tFracStep": 0 }, "essentiality": "preferred",
      "extensions": { "oneTurnedAway": true, "notUsedAsBehavioralAuthority": true }
    }
  ],
  "choreography": {
    "clipSeconds": 20, "warmupSeconds": 1,
    "interactions": [
      { "id": "signal-ego-dark", "actor": "@world", "verb": "set", "trigger": { "kind": "at", "t": 0 }, "target": { "key": "signal:feature:dark-junction:ego.phase", "value": "off" } },
      { "id": "signal-opposing-dark", "actor": "@world", "verb": "set", "trigger": { "kind": "at", "t": 0 }, "target": { "key": "signal:feature:dark-junction:opposing.phase", "value": "off" } },
      { "id": "signal-left-dark", "actor": "@world", "verb": "set", "trigger": { "kind": "at", "t": 0 }, "target": { "key": "signal:feature:dark-junction:left.phase", "value": "off" } },
      { "id": "signal-right-dark", "actor": "@world", "verb": "set", "trigger": { "kind": "at", "t": 0 }, "target": { "key": "signal:feature:dark-junction:right.phase", "value": "off" } },
      { "id": "officer-control-holds-ego", "actor": "@world", "verb": "set", "trigger": { "kind": "at", "t": 0 }, "target": { "key": "control:officer-ego-control.indication", "value": "stop" }, "label": "Native human-director control holds ego" },
      { "id": "ego-full-stop", "actor": "ego", "verb": "speed", "trigger": { "kind": "at", "t": 0 }, "target": { "mode": "stop" }, "dynamics": { "shape": "step", "constraint": "time", "value": 0.1 }, "label": "Ego remains at a full stop for well over two seconds" },
      { "id": "pedestrians-held", "actor": "pedestrian-group", "verb": "speed", "trigger": { "kind": "at", "t": 0 }, "target": { "mode": "stop" }, "dynamics": { "shape": "step", "constraint": "time", "value": 0.1 } },
      { "id": "officer-waves-cross", "actor": "officer", "verb": "set", "trigger": { "kind": "at", "t": 1 }, "target": { "key": "pose.gesture", "value": "wave_through" }, "label": "Officer waves established cross traffic through" },
      { "id": "bus-turns", "actor": "turning-bus", "verb": "speed", "trigger": { "kind": "at", "t": 5 }, "target": { "mode": "absolute", "valueKph": 18 }, "dynamics": { "shape": "linear", "constraint": "time", "value": 0.8 }, "label": "Bus turns across the sightline and blocks the officer" },
      { "id": "officer-ambiguous-point", "actor": "officer", "verb": "set", "trigger": { "kind": "at", "t": 9 }, "target": { "key": "pose.gesture", "value": "point" }, "label": "Partly occluded gesture toward ego is not treated as permission" },
      { "id": "suv-false-start", "actor": "cross-suv", "verb": "speed", "trigger": { "kind": "at", "t": 9.4 }, "target": { "mode": "absolute", "valueKph": 8 }, "dynamics": { "shape": "linear", "constraint": "time", "value": 0.8 }, "label": "SUV begins rolling on a mistaken interpretation" },
      { "id": "ego-holds-ambiguous", "actor": "ego", "verb": "speed", "trigger": { "kind": "after", "of": "officer-ambiguous-point", "event": "start", "delayS": 0 }, "target": { "mode": "stop" }, "dynamics": { "shape": "step", "constraint": "time", "value": 0.1 }, "label": "Ego explicitly refuses the ambiguous cue" },
      { "id": "bus-clears-officer", "actor": "turning-bus", "verb": "speed", "trigger": { "kind": "at", "t": 12.5 }, "target": { "mode": "absolute", "valueKph": 18 }, "dynamics": { "shape": "linear", "constraint": "time", "value": 0.5 }, "label": "Bus accelerates clear of the officer sightline" },
      { "id": "officer-stops-suv", "actor": "officer", "verb": "set", "trigger": { "kind": "at", "t": 14 }, "target": { "key": "pose.gesture", "value": "halt" }, "label": "Clear palm orders the false-starting SUV to stop" },
      { "id": "suv-yields", "actor": "cross-suv", "verb": "speed", "trigger": { "kind": "after", "of": "officer-stops-suv", "event": "start", "delayS": 0.15 }, "target": { "mode": "stop" }, "dynamics": { "shape": "linear", "constraint": "time", "value": 0.8 }, "label": "SUV yields to the unambiguous halt" },
      { "id": "officer-beckons-ego", "actor": "officer", "verb": "set", "trigger": { "kind": "after", "of": "suv-yields", "event": "end", "delayS": 0.15 }, "target": { "key": "pose.gesture", "value": "wave_through" }, "label": "Officer explicitly beckons ego after SUV yields" },
      { "id": "officer-control-releases-ego", "actor": "@world", "verb": "set", "trigger": { "kind": "after", "of": "officer-beckons-ego", "event": "start", "delayS": 0 }, "target": { "key": "control:officer-ego-control.indication", "value": "proceed" }, "label": "Native human-director indication changes to proceed" },
      { "id": "ego-ignores-dark-heads", "actor": "ego", "verb": "set", "trigger": { "kind": "after", "of": "officer-beckons-ego", "event": "start", "delayS": 1.1 }, "target": { "key": "rules.obeySignals", "value": false }, "label": "Permission derives from persistent human control, not dark heads" },
      { "id": "ego-crosses", "actor": "ego", "verb": "speed", "trigger": { "kind": "after", "of": "officer-beckons-ego", "event": "start", "delayS": 1.1 }, "target": { "mode": "absolute", "valueKph": 12 }, "dynamics": { "shape": "linear", "constraint": "time", "value": 0.8 }, "label": "Ego responds promptly after an unambiguous cue persists for at least one second" }
    ]
  },
  "invariants": [
    { "id": "control-sequence", "kind": "event_order", "events": ["officer-waves-cross", "bus-turns", "officer-ambiguous-point", "ego-holds-ambiguous", "suv-false-start", "bus-clears-officer", "officer-stops-suv", "suv-yields", "officer-beckons-ego", "officer-control-releases-ego", "ego-crosses"], "strict": false, "essentiality": "required" },
    { "id": "pedestrian-clearance", "kind": "pet", "of": "ego", "to": "pedestrian-group", "range": [2, null], "window": [15, 20], "essentiality": "required" },
    { "id": "ego-deceleration", "kind": "decel_budget", "of": "ego", "maxMps2": 8, "essentiality": "required" }
  ],
  "variants": [], "metricSubject": "ego",
  "extensions": {
    "x-uniscenarios.stableId": "edge-06-dark-signal-human-control-v1",
    "x-uniscenarios.acceptance": {
      "initialFullStopMinS": 2, "ambiguousGestureMustNotReleaseEgo": true, "clearBeckonPersistenceMinS": 1,
      "egoIntersectionMaxKph": 15, "pedestrianClearanceMinM": 2,
      "mustNot": ["treat dark heads as green", "compete with SUV", "treat body orientation alone as permission", "wait indefinitely after unambiguous control"]
    },
    "x-uniscenarios.requiredManualEvidence": ["bus physically occludes officer during the ambiguous gesture", "officer becomes visible before the final halt and beckon"],
    "x-uniscenarios.temporaryControlSupport": "Three construction.temporary_stop_sign props are rendered; one is turned away through authored heading. The failed ego signal is a native normal_signal with off indication, and the officer is a native human_director whose indication changes from stop to proceed only after the clear final beckon."
  }
}
