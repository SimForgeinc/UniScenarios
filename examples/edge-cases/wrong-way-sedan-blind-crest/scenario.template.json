      "forbidCenterlineCrossingWhileBusAlongside": true,
      "motorcyclePositiveGap": true
    },
    "forbiddenOutcomes": ["pass between sedan and parapet", "enter opposing bus lane", "panic reverse", "lateral oscillation contact"],
    "transferInvariants": ["blind crest occlusion", "wrong-way actor in ego lane", "opposing-lane blockage", "narrow right margin", "follower pressure", "relative 45m detection distance"]
  }
