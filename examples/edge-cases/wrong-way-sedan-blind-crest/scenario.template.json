      "extensions": { "blocksCenterlineEscape": true }
    },
    {
      "id": "following-motorcycle", "kind": "on_reference",
      "label": "motorcycle applying rear pressure behind ego",
      "actor": { "class": "motorcycle", "catalogId": "vehicle.motorcycle" },
