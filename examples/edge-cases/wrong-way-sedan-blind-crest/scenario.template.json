        { "laneOffset": 0, "s": -70, "tFrac": 0, "headingOffsetRad": 3.1415926535897927 }
      ] } },
      { "id": "wrong-way-visible", "actor": "wrong-way-sedan", "verb": "set", "trigger": { "kind": "at", "t": 7.6 }, "target": { "key": "lights.brake", "value": true } },
      { "id": "ego-brakes", "actor": "ego", "verb": "speed", "trigger": { "kind": "at", "t": 9.1 }, "target": { "mode": "stop" }, "dynamics": { "shape": "linear", "constraint": "time", "value": 2.1 } },
      { "id": "wrong-way-brakes", "actor": "wrong-way-sedan", "verb": "speed", "trigger": { "kind": "at", "t": 9.2 }, "target": { "mode": "stop" }, "dynamics": { "shape": "linear", "constraint": "time", "value": 2.1 } },
      { "id": "motorcycle-brakes", "actor": "following-motorcycle", "verb": "speed", "trigger": { "kind": "after", "of": "ego-brakes", "event": "start", "delayS": 0.5 }, "target": { "mode": "stop" }, "dynamics": { "shape": "linear", "constraint": "time", "value": 2.4 } },
