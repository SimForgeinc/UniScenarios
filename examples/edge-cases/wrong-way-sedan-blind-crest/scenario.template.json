      "extensions": { "semanticType": "overpass_parapet", "minimumClearanceM": 0.4 }
    },
    {
      "id": "crest-occlusion", "catalogId": "construction.jersey_barrier_run", "label": "blind crest visibility proxy",
      "pose": { "laneOffset": 0, "s": 100, "tFrac": 0, "headingOffsetRad": 0 },
