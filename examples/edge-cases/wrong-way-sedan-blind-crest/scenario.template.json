      { "id": "egoSpeedKph", "type": "continuous", "unit": "kph", "tier": 1, "range": [38, 42], "default": 40, "distribution": "uniform" },
      { "id": "detectionDistanceM", "type": "continuous", "unit": "m", "tier": 1, "range": [42, 48], "default": 45, "distribution": "uniform" }
