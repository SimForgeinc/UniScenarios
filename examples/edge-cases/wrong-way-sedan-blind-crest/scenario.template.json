      { "id": "wrong-way-offsets", "actor": "wrong-way-sedan", "verb": "laneOffset", "trigger": { "kind": "at", "t": 13 }, "target": { "tFrac": 0.35, "reference": "lane_center" }, "dynamics": { "shape": "sinusoidal", "constraint": "time", "value": 2 } },
      { "id": "hold-position", "actor": "ego", "verb": "set", "trigger": { "kind": "at", "t": 18 }, "target": { "key": "lights.brake", "value": true } }
    ]
  },
  "invariants": [
    { "id": "hazard-response-order", "kind": "event_order", "events": ["wrong-way-visible", "ego-brakes", "motorcycle-brakes", "ego-edges-right", "hold-position"], "strict": true, "essentiality": "required" },
    { "id": "wrong-way-response-order", "kind": "event_order", "events": ["wrong-way-visible", "wrong-way-brakes", "wrong-way-offsets"], "strict": true, "essentiality": "required" },
    { "id": "rear-gap-positive", "kind": "gap", "of": "following-motorcycle", "to": "ego", "unit": "distance", "range": [0.1, 50], "window": [0, 20], "essentiality": "required" },
    { "id": "head-on-criticality", "kind": "ttc", "of": "ego", "to": "wrong-way-sedan", "range": [0.2, 5], "mode": "min", "window": [5, 16], "essentiality": "required" },
    { "id": "ego-deceleration", "kind": "decel_budget", "of": "ego", "maxMps2": 5, "essentiality": "required" }
  ],
  "variants": [],
  "metricSubject": "ego",
  "extensions": {
    "acceptanceContract": {
      "collisionFreeStop": true,
      "egoBelow5KphBeforeSeparationM": 8,
