{
  "intentId": "edge-case-07-dooring-chain-tram",
  "title": "Dooring Chain Reaction Beside Tram Tracks",
  "requiredEventOrder": ["door-opens", "cyclist-swerves", "cyclist-brakes", "ego-brakes", "trailing-cyclist-stops"],
  "acceptance": [
    { "id": "pre-event-headway", "measure": "headway(ego,lead-cyclist,0..5s)", "op": ">=", "value": 2, "unit": "s" },
    { "id": "collision-free", "measure": "collisionCount", "op": "=", "value": 0 },
    { "id": "cyclist-clearance", "measure": "minDistance(ego,lead-cyclist,5..20s)", "op": ">=", "value": 1, "unit": "m" },
    { "id": "tram-swept-path", "measure": "egoLaneOffsetToward(tram)", "op": "=", "value": 0 },
    { "id": "braking-budget", "measure": "peakDecel(ego)", "op": "<=", "value": 7, "unit": "m/s2" },
    { "id": "final-stop-gap", "measure": "distance(ego,lead-cyclist,20s)", "op": ">=", "value": 2, "unit": "m" },
    { "id": "door-articulation", "measure": "stateTransition(parked-car,doors.left)", "op": "contains", "value": ["opening", "open"] }
  ],
  "forbidden": ["ego passes lead cyclist beside open door", "ego enters tram swept path", "ego rolls backward", "contact with any actor"],
  "siteGate": {
    "exactRequired": ["curb parking", "painted bicycle space", "embedded tram rail left of general lane", "occupied tram swept path", "no simultaneous pass width"],
    "allowBehavioralSurrogate": true,
    "surrogateMustBeLabeled": true
  }
}
