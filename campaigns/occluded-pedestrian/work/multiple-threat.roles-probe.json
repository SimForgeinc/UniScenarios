  "props": [],
  "choreography": {
    "clipSeconds": 14,
    "warmupSeconds": 1,
    "interactions": [
      {
        "id": "ped-commits",
        "label": "the pedestrian trusts the stopped queue and does not check the second lane",
        "actor": "ped",
        "verb": "set",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "key": "rules.collisionAvoidance",
          "value": false
        }
      },
      {
        "id": "ped-ignores-traffic",
        "actor": "ped",
        "verb": "set",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "key": "rules.yieldToVehicles",
          "value": false
        }
      },
      {
        "id": "ped-crosses",
        "label": "along the kerb, then across the stopped lane and into the ego lane",
        "actor": "ped",
        "verb": "route",
        "trigger": {
          "kind": "at",
          "t": 0
        },
        "target": {
          "mode": "polyline",
          "points": [
            {
              "laneOffset": 0,
              "s": 60,
              "tFrac": -1,
              "headingOffsetRad": 0
            },
            {
              "laneOffset": 0,
              "s": "125 - param.dartLeadM",
              "tFrac": -1,
              "headingOffsetRad": 0
            },
            {
              "laneOffset": 0,
              "s": 126,
              "tFrac": 1,
              "headingOffsetRad": 0
            }
          ]
        }
      },
      {
        "id": "ped-reaches-the-ego-lane",
        "label": "arrival, aimed at the reference centreline (a PointRef pose carries no tFrac) and compensated by the lane width the pedestrian still has to walk",
        "actor": "ped",
        "verb": "speed",
        "trigger": {
          "kind": "arrival",
          "of": "ped",
          "at": {
            "pose": {
              "laneOffset": 0,
              "s": 125,
              "tFrac": 0,
              "headingOffsetRad": 0
            }
          },
          "syncWith": "ego",
          "ttc": "param.arrivalTtc + 3.6 * lane.widthM / param.pedSpeedKph"
        },
        "target": {
          "mode": "absolute",
          "valueKph": "param.pedSpeedKph"
        },
        "dynamics": {
