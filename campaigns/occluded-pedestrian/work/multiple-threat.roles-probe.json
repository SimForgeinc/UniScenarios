{
  "scenarioVersion": 2,
  "meta": {
    "name": "PROBE: multiple threat with the queue as roles",
    "description": "The US 'multiple threat' geometry: traffic in the kerb lane has stopped, a pedestrian crosses in front of the stopped lead vehicle, and the ego — in the lane beside it, with a clear road ahead of *itself* — has no line of sight until the pedestrian steps past the queue. The reference lane is the kerb lane, so the ego binds one lane to its left (`lane_offset k = +1`), which is also what selects the sites: a corridor whose reference lane has no left neighbour is infeasible, and that is exactly the corridor this scenario does not mean. The queue is the occluder, and it is modelled as L3 props rather than as actors on purpose — see the campaign report: the engine's pairwise TTC is lane-agnostic and circumscribes both footprints, so any *actor* standing 3.5 m to the ego's side drives the episode's min-TTC to zero and steals the metric from the pedestrian.",
    "createdAt": "2026-08-01T00:00:00.000Z",
    "modifiedAt": "2026-08-01T00:00:00.000Z",
    "appVersion": "scen/0.0.1",
    "archetype": "C5.multiple-threat",
    "tags": [
      "vru",
      "occlusion",
      "multiple-threat",
      "stopped-queue",
      "prop-occluder",
      "campaign-occluded-pedestrian"
    ],
    "author": "agent/campaign-occluded-pedestrian",
    "negativeControl": false
  },
  "params": {
    "declarations": [
      {
        "id": "arrivalTtc",
        "type": "continuous",
        "description": "Seconds between the pedestrian reaching the ego lane and the ego reaching the same point.",
        "unit": "s",
        "tier": 1,
        "range": [
          0.8,
          2.5
        ],
        "default": 1.6,
        "distribution": "uniform"
      },
      {
        "id": "pedSpeedKph",
        "type": "continuous",
        "description": "Pedestrian travel speed; Euro NCAP walk = 5 km/h, run = 8 km/h.",
        "unit": "kph",
        "tier": 1,
        "range": [
          4.0,
          8.5
        ],
        "default": 5.4,
        "distribution": "uniform"
      },
      {
        "id": "queueGapM",
        "type": "continuous",
        "description": "Metres between the stopped lead vehicle's centre and the line the pedestrian crosses on. Small values put the pedestrian right across the lead vehicle's bonnet.",
        "unit": "m",
        "tier": 1,
        "range": [
          3.5,
          9.0
        ],
        "default": 5.5,
        "distribution": "uniform"
      },
      {
        "id": "dartLeadM",
        "type": "continuous",
        "description": "Metres upstream of the conflict point at which the pedestrian leaves the kerb line. Together with `pedSpeedKph` this is the reveal-to-conflict lever — the occluder's longitudinal position is not.",
        "unit": "m",
        "tier": 1,
        "range": [
          2.0,
          6.0
        ],
        "default": 3.5,
        "distribution": "uniform"
      }
    ],
    "constraints": []
  },
  "environment": {
    "weather": "clear",
    "timeOfDay": "afternoon"
  },
  "anchor": {
    "id": "multiple-threat",
    "corridor": {
