{
  "schema": "uniscenarios.simcloud-integration/v1",
  "platformRepository": "https://github.com/SimForgeinc/simcloud-platform",
  "ignoredNames": [
    ".turbo",
    "dist",
    "node_modules",
    "package.json",
    "README.md",
    "tsconfig.json"
  ],
  "surfaces": [
